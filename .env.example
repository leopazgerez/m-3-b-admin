# ===================================================
# Mates 3B Admin - Environment Variables Template
# ===================================================

# URL base de la API del Backend (ej: http://localhost:8000/api o https://api.tudominio.com/api)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Host o dominio base del backend (sin ruta /api, útil para sockets o assets)
NEXT_PUBLIC_API_HOST=http://localhost:8000

# Base Path para despliegues en GitHub Pages (ej: /m-3-b-admin)
# En local o con dominio personalizado, dejar vacío:
NEXT_PUBLIC_BASE_PATH=
